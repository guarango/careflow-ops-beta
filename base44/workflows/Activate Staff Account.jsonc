{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup",
        "login"
      ]
    }
  },
  "description": "On app-user signup and every login, links the login to its StaffMember, activates a pending person, copies app access onto the login and syncs their caseload.",
  "name": "Activate Staff Account",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "activate_staff_account",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "activate_account": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "activateStaffAccount",
            "args": {
              "user_id": "${ .trigger.user_id }",
              "email": "${ .trigger.email }",
              "auth_method": "${ .trigger.auth_method }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Activate staff account",
            "description": "Pending person becomes active, then access and caseload land on their login"
          }
        }
      }
    ]
  }
}