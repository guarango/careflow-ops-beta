{
  "name": "EVV Auto-Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "evv_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_evv": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoSyncEvv"
          },
          "then": "end",
          "x-base44": {
            "title": "Submit pending EVV records",
            "description": "Auto-submits via SOAP API for all active integrations"
          }
        }
      }
    ]
  },
  "description": "Daily automatic EVV record submission to state Medicaid via SOAP API for all agencies with active EVV integrations",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 23 * * *",
      "one_time_date": null,
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}