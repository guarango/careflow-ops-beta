{
  "name": "QoLMilestone",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "milestone_date": {
      "type": "string",
      "format": "date"
    },
    "milestone_type": {
      "type": "string",
      "enum": [
        "Domain Best Score",
        "New Relationship",
        "Community Connection",
        "Employment",
        "Goal Mastered",
        "Life Vision Progress",
        "Self-Advocacy Moment",
        "Other"
      ],
      "default": "Other"
    },
    "domain": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "in_persons_words": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "milestone_date",
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.client_id": {
                "$in": "{{user.data.assigned_client_ids}}"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    }
  }
}