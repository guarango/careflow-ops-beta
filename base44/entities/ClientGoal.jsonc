{
  "name": "ClientGoal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "goal_title": {
      "type": "string",
      "description": "Observable, measurable goal in SMART format"
    },
    "pcsp_id": {
      "type": "string",
      "description": "ISPlan record this Support Strategy serves \u2014 the active PCSP when the strategy was written"
    },
    "pcsp_goal_id": {
      "type": "string",
      "description": "Which PCSP goal this strategy serves (the PCSP goal's linked goal_id, or text:<goal as written>)"
    },
    "service_code_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Responsible service codes \u2014 limited to the services authorized on the linked PCSP"
    },
    "strategy_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready",
        "Submitted to SC",
        "Revised"
      ],
      "default": "Draft",
      "enumColors": [
        "gray",
        "blue",
        "green",
        "yellow"
      ],
      "description": "Support Strategy lifecycle: written \u2192 ready \u2192 submitted to the support coordinator \u2192 revised"
    },
    "submitted_to_sc_date": {
      "type": "string",
      "format": "date",
      "description": "Date the strategy was submitted to the support coordinator"
    },
    "submitted_by": {
      "type": "string"
    },
    "submission_method": {
      "type": "string",
      "enum": [
        "UPI",
        "Email",
        "Other"
      ]
    },
    "submission_note": {
      "type": "string"
    },
    "revision_reason": {
      "type": "string",
      "description": "Required when a submitted strategy is moved to Revised"
    },
    "domain": {
      "type": "string",
      "enum": [
        "Communication",
        "Activities of Daily Living",
        "Community Integration",
        "Social Skills",
        "Vocational/Employment",
        "Health & Wellness",
        "Behavioral Support",
        "Self-Advocacy",
        "Mobility & Motor Skills",
        "Leisure & Recreation",
        "Other"
      ]
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "Acquisition",
        "Maintenance",
        "Generalization",
        "Reduction"
      ],
      "description": "Acquisition=learning new, Maintenance=keeping skill, Generalization=new settings, Reduction=decreasing behavior"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Mastered",
        "Discontinued",
        "On Hold"
      ],
      "default": "Active"
    },
    "connection_to_personal_outcome": {
      "type": "string",
      "description": "How this goal connects to the person's broader life vision"
    },
    "persons_own_words": {
      "type": "string",
      "description": "What does this goal mean to them, in their language"
    },
    "personal_strengths": {
      "type": "string",
      "description": "Relevant strengths the person brings to this goal"
    },
    "preferred_strategies": {
      "type": "string",
      "description": "Preferred engagement strategies and known reinforcers"
    },
    "preferred_people": {
      "type": "string",
      "description": "Who the person wants involved \u2014 staff, family, natural supports"
    },
    "best_times_settings": {
      "type": "string",
      "description": "Best time of day or settings where person is most successful"
    },
    "trauma_considerations": {
      "type": "string",
      "description": "Trauma-informed considerations or known triggers to avoid"
    },
    "baseline_description": {
      "type": "string",
      "description": "Current performance level at time of goal writing"
    },
    "baseline_date": {
      "type": "string",
      "format": "date"
    },
    "baseline_assessed_by": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "description": "Short-term milestone objectives toward the main goal",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "target_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Met",
              "Not Met"
            ]
          }
        }
      }
    },
    "mastery_criteria": {
      "type": "string",
      "description": "e.g. 80% accuracy across 3 consecutive sessions with 2 different staff"
    },
    "prompt_level_baseline": {
      "type": "string",
      "enum": [
        "Full Physical Assist",
        "Hand-Over-Hand",
        "Physical Prompt",
        "Gestural Prompt",
        "Verbal Prompt",
        "Indirect Verbal Cue",
        "Independent"
      ],
      "description": "Support intensity at baseline"
    },
    "prompt_fading_plan": {
      "type": "string",
      "description": "Expected trajectory of prompt fading"
    },
    "goal_narrative": {
      "type": "string",
      "description": "Plain language narrative suitable for reading aloud at a care team meeting"
    },
    "primary_measurement_method": {
      "type": "string",
      "enum": [
        "Frequency Count",
        "Duration Recording",
        "Percentage of Trials",
        "Momentary Time Sampling",
        "Partial Interval Recording",
        "Task Analysis Step Count",
        "Likert-Scale Rating",
        "Anecdotal/Observational"
      ]
    },
    "secondary_measurement_method": {
      "type": "string"
    },
    "minimum_trials_per_session": {
      "type": "number",
      "description": "Minimum trials before session data is considered valid"
    },
    "data_collection_schedule": {
      "type": "string",
      "enum": [
        "Every Session",
        "Daily",
        "Weekly",
        "Monthly",
        "As Natural Opportunity Arises"
      ]
    },
    "data_collector_role": {
      "type": "string",
      "enum": [
        "DSP",
        "Job Coach",
        "Nurse",
        "Behavior Analyst",
        "Teacher",
        "Any Staff"
      ]
    },
    "data_collection_instructions": {
      "type": "string",
      "description": "Plain-language guidance written for DSP with no clinical background"
    },
    "goal_author": {
      "type": "string"
    },
    "supervising_clinician": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "regulatory_framework": {
      "type": "string",
      "enum": [
        "HCBS Waiver",
        "ICF/IDD",
        "State-Funded",
        "School IEP Transition",
        "Vocational Rehab",
        "Private Pay",
        "Other"
      ]
    },
    "team_notes": {
      "type": "string",
      "description": "Meeting minutes or team decisions"
    },
    "charting_mode": {
      "type": "string",
      "enum": [
        "Scheduled",
        "PRN"
      ],
      "default": "Scheduled",
      "description": "Scheduled = charted on set days/shifts. PRN = charted when DSP chooses to work on it."
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ]
      },
      "description": "Days of the week this scheduled goal should be charted"
    },
    "schedule_shift_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shift IDs this scheduled goal should be charted on (optional)"
    },
    "prn_monthly_minimum": {
      "type": "number",
      "description": "Optional minimum number of times per month a PRN goal should be charted"
    },
    "measurement_type": {
      "type": "string",
      "enum": [
        "trials",
        "frequency",
        "duration",
        "percentage"
      ],
      "description": "Simplified charting measurement type"
    },
    "target_value": {
      "type": "number",
      "description": "Numeric target for the measurement (e.g. 80 for 80%, 5 for 5 trials)"
    },
    "frequency": {
      "type": "string",
      "description": "Legacy tracking frequency field"
    },
    "method": {
      "type": "string",
      "description": "Legacy method field"
    },
    "baseline": {
      "type": "string",
      "description": "Legacy baseline field"
    },
    "target": {
      "type": "string",
      "description": "Legacy target field"
    },
    "description": {
      "type": "string"
    },
    "progress_entries": {
      "type": "array",
      "description": "Goal data entries. An entry charted inside a service note inherits its session_note_id, date, times, staff and service code and is never edited \u2014 corrections are a new entry plus the exclusion of the old one.",
      "items": {
        "type": "object",
        "properties": {
          "goal_id": {
            "type": "string"
          },
          "session_note_id": {
            "type": "string",
            "description": "Service note this entry was charted inside (required for note-generated entries)"
          },
          "date": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "description": "Inherited from the note"
          },
          "end_time": {
            "type": "string",
            "description": "Inherited from the note"
          },
          "staff_id": {
            "type": "string",
            "description": "Inherited from the note"
          },
          "staff_name": {
            "type": "string",
            "description": "Inherited from the note"
          },
          "service_code_id": {
            "type": "string",
            "description": "Inherited from the note"
          },
          "service_code": {
            "type": "string"
          },
          "setting": {
            "type": "string"
          },
          "charting_mode": {
            "type": "string",
            "enum": [
              "Scheduled",
              "PRN"
            ]
          },
          "trials_correct": {
            "type": "number"
          },
          "trials_total": {
            "type": "number"
          },
          "duration_minutes": {
            "type": "number"
          },
          "frequency_count": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          },
          "percentage": {
            "type": "number"
          },
          "computed_score": {
            "type": "number",
            "description": "System-calculated \u2014 never typed by a DSP"
          },
          "score": {
            "type": "string",
            "description": "Display label of the computed score, e.g. 8/10 (80%)"
          },
          "prompt_level": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "shift_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Valid",
              "Flagged",
              "Excluded"
            ],
            "default": "Valid",
            "enumColors": [
              "green",
              "yellow",
              "gray"
            ],
            "description": "Valid entries are evidence; Flagged await manager review; Excluded entries were corrected and never count"
          },
          "flagged_reason": {
            "type": "string"
          },
          "flagged_by": {
            "type": "string"
          },
          "flagged_at": {
            "type": "string"
          },
          "exclusion_reason": {
            "type": "string"
          },
          "excluded_by": {
            "type": "string"
          },
          "excluded_at": {
            "type": "string"
          },
          "missed_reason": {
            "type": "string",
            "enum": [
              "Client refused",
              "Client not home",
              "Client ill",
              "Other"
            ]
          },
          "missed_comment": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "client_id",
    "goal_title",
    "domain"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}