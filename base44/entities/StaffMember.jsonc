{
  "name": "StaffMember",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string",
      "description": "Name the person goes by \u2014 editable by the staff member themselves"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The person's email \u2014 also the identity of their single login"
    },
    "phone": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "User account ID linked to this staff member (set when the invite is accepted)"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "ssn_last4": {
      "type": "string",
      "description": "Last 4 digits of SSN only"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Non-binary",
        "Prefer not to say"
      ]
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "Single",
        "Married",
        "Divorced",
        "Widowed",
        "Other"
      ]
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relation": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "description": "The person's own availability notes (days/times) \u2014 editable by the staff member"
    },
    "role": {
      "type": "string",
      "enum": [
        "DSP",
        "Nurse",
        "QIDP",
        "Supervisor",
        "Admin",
        "Behavioral Specialist",
        "Mental Health Pro",
        "Contractor",
        "Volunteer",
        "Non-Client Facing",
        "Other"
      ],
      "description": "Job title (HR information only \u2014 never grants app access)"
    },
    "app_access": {
      "type": "string",
      "enum": [
        "dsp",
        "manager",
        "admin"
      ],
      "default": "dsp",
      "description": "App access level chosen by an Admin. Independent of job title. Changed only through setStaffAccess."
    },
    "hr_bundle": {
      "type": "boolean",
      "default": false,
      "description": "HR permission bundle \u2014 only valid when app_access is admin"
    },
    "billing_bundle": {
      "type": "boolean",
      "default": false,
      "description": "Billing permission bundle \u2014 only valid when app_access is admin"
    },
    "invited_by": {
      "type": "string",
      "description": "Name of the admin who sent the invite"
    },
    "invited_at": {
      "type": "string",
      "description": "When the invite was sent"
    },
    "activated_at": {
      "type": "string",
      "description": "When the person first signed in"
    },
    "onboarding_step": {
      "type": "number",
      "default": 0,
      "description": "Index of the first-login onboarding step the person is on. Saved after each step so they resume where they left off."
    },
    "onboarding_completed_at": {
      "type": "string",
      "description": "When the first-login onboarding wizard was finished"
    },
    "deactivated_at": {
      "type": "string"
    },
    "deactivated_by": {
      "type": "string"
    },
    "deactivation_reason": {
      "type": "string"
    },
    "staff_type": {
      "type": "string",
      "enum": [
        "Regular",
        "Probationary"
      ],
      "default": "Regular"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Full Time",
        "Part Time"
      ]
    },
    "employee_class": {
      "type": "string",
      "enum": [
        "Non-Exempt",
        "Exempt"
      ]
    },
    "contract_areas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DSPD",
          "DCFS",
          "Private Pay",
          "Licensed Program",
          "Foster Care"
        ]
      },
      "description": "Contract areas this employee works in"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Active",
        "Inactive"
      ],
      "default": "Pending",
      "description": "Pending = invited, not signed in yet. Active = has signed in. Inactive = deactivated, history kept."
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "termination_date": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "background_check_date": {
      "type": "string",
      "format": "date"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Cleared",
        "Failed",
        "Expired"
      ]
    },
    "background_check_notes": {
      "type": "string"
    },
    "i9_verified": {
      "type": "boolean",
      "default": false
    },
    "i9_date": {
      "type": "string",
      "format": "date"
    },
    "drug_screen_date": {
      "type": "string",
      "format": "date"
    },
    "drug_screen_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Passed",
        "Failed",
        "Expired"
      ]
    },
    "tb_test_date": {
      "type": "string",
      "format": "date"
    },
    "tb_test_result": {
      "type": "string",
      "enum": [
        "Negative",
        "Positive",
        "Pending"
      ]
    },
    "tb_test_expiry": {
      "type": "string",
      "format": "date"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "Current",
              "Expiring Soon",
              "Expired"
            ]
          },
          "doc_url": {
            "type": "string",
            "description": "Evidence file URI"
          },
          "doc_name": {
            "type": "string"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "Pending verification",
              "Verified",
              "Rejected"
            ],
            "description": "Set to Pending verification for evidence uploaded by the staff member themselves; HR or their Manager verifies."
          },
          "submitted_by_staff": {
            "type": "boolean",
            "default": false
          },
          "submitted_at": {
            "type": "string"
          },
          "verified_by": {
            "type": "string"
          },
          "verified_at": {
            "type": "string"
          }
        }
      }
    },
    "training_hours": {
      "type": "number",
      "default": 0
    },
    "orientation_completed": {
      "type": "boolean",
      "default": false
    },
    "orientation_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Client IDs directly assigned to this staff member",
      "default": []
    },
    "assigned_house_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "House IDs this staff member manages (managers only). Clients in these houses are included in their caseload.",
      "default": []
    },
    "sms_opted_in": {
      "type": "boolean",
      "default": false,
      "description": "Staff opted in to receive SMS notifications during onboarding"
    },
    "sms_opted_in_at": {
      "type": "string",
      "description": "Timestamp when SMS consent was recorded"
    },
    "sms_opted_out_at": {
      "type": "string",
      "description": "Timestamp when SMS consent was revoked"
    },
    "sms_phone": {
      "type": "string",
      "description": "Phone number for SMS (may differ from primary phone)"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Whether the staff member receives email notifications"
    },
    "push_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Whether the staff member receives push notifications (when available)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}