{
  "name": "BillingRecord",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "medicaid_id": {
      "type": "string",
      "description": "Client Medicaid ID for billing export"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Residential",
        "Day Program",
        "Community Living",
        "Respite",
        "Supported Employment"
      ]
    },
    "service_code_id": {
      "type": "string"
    },
    "service_code": {
      "type": "string"
    },
    "shift_id": {
      "type": "string",
      "description": "Linked ShiftSchedule record"
    },
    "session_note_id": {
      "type": "string",
      "description": "Linked approved SessionNote"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "hours": {
      "type": "number"
    },
    "units": {
      "type": "number",
      "description": "Billable units (15-min, hourly, or daily)"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "15-minute",
        "Hourly",
        "Daily"
      ]
    },
    "rate": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "evv_verified": {
      "type": "boolean",
      "default": false
    },
    "insurance_provider": {
      "type": "string"
    },
    "claim_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Submitted",
        "Paid",
        "Denied",
        "Appealed"
      ],
      "default": "Pending"
    },
    "billable": {
      "type": "boolean",
      "default": false,
      "description": "True if all billing prerequisites are met"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reasons this record is not billable"
    },
    "exported": {
      "type": "boolean",
      "default": false,
      "description": "True if included in a billing export"
    },
    "exported_at": {
      "type": "string"
    },
    "export_id": {
      "type": "string",
      "description": "BillingExportLog ID"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "service_type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}