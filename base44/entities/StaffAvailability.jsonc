{
  "name": "StaffAvailability",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "availability": {
      "type": "array",
      "description": "Weekly availability slots",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ]
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          }
        }
      }
    },
    "max_hours_per_week": {
      "type": "number"
    },
    "preferred_clients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred client IDs"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "staff_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}