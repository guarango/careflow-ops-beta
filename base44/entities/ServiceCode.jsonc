{
  "name": "ServiceCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Service code (e.g. T2016, H2015)"
    },
    "description": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "Hourly",
        "Daily",
        "Per Unit",
        "Monthly"
      ],
      "default": "Hourly"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "15-minute",
        "Hourly",
        "Daily"
      ],
      "default": "Hourly",
      "description": "Billing unit type: 15-minute units, hourly, or daily"
    },
    "rate": {
      "type": "number",
      "description": "State payout rate"
    },
    "unit_minutes": {
      "type": "number",
      "description": "Minutes per unit (for Per Unit billing)",
      "default": 15
    },
    "funding_source": {
      "type": "string",
      "enum": [
        "Medicaid",
        "Medicaid Waiver",
        "State",
        "Private",
        "Other"
      ],
      "default": "Medicaid Waiver"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Residential",
        "Day Program",
        "Community Living",
        "Respite",
        "Supported Employment",
        "Behavioral Support",
        "Nursing",
        "Other"
      ]
    },
    "is_evv_required": {
      "type": "boolean",
      "default": false,
      "description": "EVV required for this service (DHHS91172 SOW 1.12)"
    },
    "summary_cadence": {
      "type": "string",
      "enum": [
        "Quarterly",
        "Monthly",
        "Monthly Financial Statement",
        "None"
      ],
      "default": "Quarterly",
      "description": "How often a summary is required for this service (SOW 1.25)"
    },
    "support_strategy_required": {
      "type": "boolean",
      "default": true,
      "description": "True when a Support Strategy must be documented (SOW 1.24(5)). Replaces is_exempt_support_strategies (inverse)."
    },
    "support_strategy_type": {
      "type": "string",
      "enum": [
        "Standard",
        "Behavior Support Plan",
        "Medical Care Plan"
      ],
      "description": "Which plan type carries the support strategy. Empty when no strategy is required."
    },
    "goal_progress_required_in_summary": {
      "type": "boolean",
      "default": true,
      "description": "True when quarterly/long-term summaries must show goal progress (SOW 1.25(5))"
    },
    "daily_note_required": {
      "type": "boolean",
      "default": true
    },
    "annual_report_required": {
      "type": "boolean",
      "default": false,
      "description": "True when a fiscal-year annual report is required for this service"
    },
    "state": {
      "type": "string",
      "default": "UT",
      "description": "US state code the rule set comes from"
    },
    "rule_source": {
      "type": "string",
      "description": "Citation for these requirements, e.g. DHHS91172 SOW 1.25"
    },
    "rule_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "False when the state rule behind these settings has not been verified yet"
    },
    "source_reference": {
      "type": "string",
      "description": "Full citation for this code's verified rule set, e.g. DHHS91172 SOW \u00a71.25 (quarterly summary) and \u00a721.3(6) (evacuation drills)"
    },
    "compliance_rules": {
      "type": "array",
      "description": "Individual state requirements for this code. Each rule carries its own confirmation \u2014 confirming one rule never confirms the others.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable identifier, e.g. quarterly_summary or quarterly_evacuation_drills"
          },
          "label": {
            "type": "string"
          },
          "cadence": {
            "type": "string",
            "description": "How often the rule applies, e.g. Quarterly"
          },
          "detail": {
            "type": "string",
            "description": "What the rule requires"
          },
          "rule_confirmed": {
            "type": "boolean",
            "default": false,
            "description": "True once this individual rule has been verified against the contract"
          },
          "source_reference": {
            "type": "string",
            "description": "Citation for this individual rule"
          }
        },
        "required": [
          "key",
          "label"
        ]
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "description",
    "rate_type",
    "rate"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "dsp"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}