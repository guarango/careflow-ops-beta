{
  "name": "ServiceCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Service code (e.g. T2016, H2015)"
    },
    "description": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "Hourly",
        "Daily",
        "Per Unit",
        "Monthly"
      ],
      "default": "Hourly"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "15-minute",
        "Hourly",
        "Daily"
      ],
      "default": "Hourly",
      "description": "Billing unit type: 15-minute units, hourly, or daily"
    },
    "rate": {
      "type": "number",
      "description": "State payout rate"
    },
    "unit_minutes": {
      "type": "number",
      "description": "Minutes per unit (for Per Unit billing)",
      "default": 15
    },
    "funding_source": {
      "type": "string",
      "enum": [
        "Medicaid",
        "Medicaid Waiver",
        "State",
        "Private",
        "Other"
      ],
      "default": "Medicaid Waiver"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Residential",
        "Day Program",
        "Community Living",
        "Respite",
        "Supported Employment",
        "Behavioral Support",
        "Nursing",
        "Other"
      ]
    },
    "is_evv_required": {
      "type": "boolean",
      "default": false,
      "description": "True for EVV-required services: Companion, Homemaker, Respite (except RP4, RP5, RPS), Supported Living, Personal Assistance"
    },
    "is_exempt_support_strategies": {
      "type": "boolean",
      "default": false,
      "description": "True for ELS, MTP, PBA, Professional Medication Monitoring, Respite - exempt from support strategies and quarterly goal progress"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "description",
    "rate_type",
    "rate"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.funding_source": "Medicaid Waiver"
        },
        {
          "data.funding_source": "Medicaid"
        },
        {
          "data.funding_source": "State"
        },
        {
          "data.funding_source": "Private"
        },
        {
          "data.funding_source": "Other"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}