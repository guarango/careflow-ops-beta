{
  "name": "ShiftSchedule",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "house_id": {
      "type": "string",
      "description": "House/Location ID this shift is at"
    },
    "house_name": {
      "type": "string",
      "description": "Denormalized house name"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "service_code_id": {
      "type": "string"
    },
    "service_code": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "rate_type": {
      "type": "string",
      "enum": [
        "Hourly",
        "Daily",
        "Per Unit",
        "Monthly"
      ]
    },
    "rate": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "total_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Cancelled",
        "No Show"
      ],
      "default": "Scheduled"
    },
    "evv_clock_in": {
      "type": "string",
      "description": "Actual clock-in time recorded by staff (EVV)"
    },
    "evv_clock_out": {
      "type": "string",
      "description": "Actual clock-out time recorded by staff (EVV)"
    },
    "evv_verified": {
      "type": "boolean",
      "default": false
    },
    "evv_log_id": {
      "type": "string",
      "description": "Linked EVVLog record"
    },
    "billing_created": {
      "type": "boolean",
      "default": false
    },
    "billing_record_id": {
      "type": "string"
    },
    "recurring_series_id": {
      "type": "string",
      "description": "ID grouping recurring shifts"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "staff_id",
    "date",
    "start_time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}