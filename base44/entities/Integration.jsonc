{
  "name": "Integration",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "integration_key": {
      "type": "string",
      "description": "Registry key (e.g. utah_evv, custom_state_evv)"
    },
    "integration_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "evv",
        "custom"
      ]
    },
    "state": {
      "type": "string",
      "description": "US state code (UT, CO, etc.)"
    },
    "state_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "disconnected",
        "connected",
        "error",
        "pending"
      ],
      "default": "disconnected"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "submission_method": {
      "type": "string",
      "enum": [
        "soap",
        "rest",
        "csv"
      ],
      "description": "Primary EVV submission method"
    },
    "api_endpoint": {
      "type": "string",
      "description": "State EVV API endpoint URL"
    },
    "auth_type": {
      "type": "string",
      "enum": [
        "certificate",
        "oauth",
        "api_key",
        "basic",
        "utah_id_sso"
      ]
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "Submit to state test/sandbox environment"
    },
    "credentials": {
      "type": "object",
      "description": "Encrypted credentials map"
    },
    "field_mappings": {
      "type": "object",
      "description": "Mapping from CareFlow data fields to state EVV data elements"
    },
    "last_submission_at": {
      "type": "string",
      "description": "Last EVV record batch submission timestamp"
    },
    "last_submission_batch_id": {
      "type": "string"
    },
    "last_submission_record_count": {
      "type": "number",
      "default": 0
    },
    "last_submission_status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "partial",
        "pending"
      ]
    },
    "last_sync_at": {
      "type": "string"
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "partial"
      ]
    },
    "total_records_synced": {
      "type": "number",
      "default": 0
    },
    "error_count_24h": {
      "type": "number",
      "default": 0
    },
    "records_synced_24h": {
      "type": "number",
      "default": 0
    },
    "baa_signed": {
      "type": "boolean",
      "default": false
    },
    "baa_signed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "agency_id",
    "integration_key",
    "integration_name",
    "category"
  ]
}