{
  "name": "BillingExportLog",
  "type": "object",
  "properties": {
    "exported_by": {
      "type": "string",
      "description": "User ID who ran the export"
    },
    "exported_by_name": {
      "type": "string"
    },
    "exported_at": {
      "type": "string"
    },
    "date_from": {
      "type": "string",
      "format": "date"
    },
    "date_to": {
      "type": "string",
      "format": "date"
    },
    "record_count": {
      "type": "number",
      "default": 0
    },
    "total_units": {
      "type": "number",
      "default": 0
    },
    "file_name": {
      "type": "string"
    }
  },
  "required": [
    "exported_by",
    "date_from",
    "date_to"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}