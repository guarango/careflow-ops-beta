{
  "name": "Authorization",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "service_code_id": {
      "type": "string"
    },
    "service_code": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "funding_source": {
      "type": "string",
      "enum": [
        "Medicaid",
        "Medicaid Waiver",
        "State",
        "Private",
        "Other"
      ]
    },
    "auth_number": {
      "type": "string",
      "description": "Prior authorization number from payer"
    },
    "payer": {
      "type": "string"
    },
    "authorized_units": {
      "type": "number"
    },
    "used_units": {
      "type": "number",
      "default": 0
    },
    "remaining_units": {
      "type": "number"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "Hours",
        "Visits",
        "Days",
        "Units"
      ],
      "default": "Hours"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending Submission",
        "Submitted",
        "Approved",
        "Denied",
        "Expired",
        "Pending Appeal"
      ],
      "default": "Pending Submission"
    },
    "approval_document_url": {
      "type": "string"
    },
    "denial_reason": {
      "type": "string"
    },
    "alert_threshold_pct": {
      "type": "number",
      "default": 80,
      "description": "Alert when this % of units used"
    },
    "alert_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "service_code",
    "authorized_units",
    "unit_type",
    "start_date",
    "end_date"
  ]
}