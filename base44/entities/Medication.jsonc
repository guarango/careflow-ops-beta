{
  "name": "Medication",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "dosage": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "Oral",
        "Topical",
        "Injection",
        "Inhaled",
        "Sublingual",
        "Other"
      ]
    },
    "frequency": {
      "type": "string",
      "enum": [
        "Once daily",
        "Twice daily",
        "Three times daily",
        "Four times daily",
        "As needed",
        "Weekly",
        "Other"
      ]
    },
    "scheduled_times": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prescriber": {
      "type": "string"
    },
    "pharmacy": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "instructions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Discontinued",
        "On Hold"
      ],
      "default": "Active"
    }
  },
  "required": [
    "client_id",
    "medication_name",
    "dosage",
    "frequency"
  ]
}