{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "dsp",
        "manager",
        "admin"
      ],
      "default": "dsp",
      "description": "dsp, manager, or admin. Super Admin = admin with is_super_admin=true.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Platform owner. Effective role becomes super_admin when true.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_deactivated": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user account is deactivated and cannot access the app.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "hr_bundle": {
      "type": "boolean",
      "default": false,
      "description": "Admin-only: staff HR files, onboarding, e-signature templates, trainings, staff compliance",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "billing_bundle": {
      "type": "boolean",
      "default": false,
      "description": "Admin-only: service code rates, authorizations, unit tracking, payroll export, billing export, EVV export",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "staff_member_id": {
      "type": "string",
      "description": "StaffMember record ID linked to this user account",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "assigned_client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Full caseload: directly assigned clients + clients in assigned houses. Maintained by syncStaffAssignments function.",
      "default": [],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "assigned_house_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Houses this user is directly assigned to manage. Maintained by syncStaffAssignments function.",
      "default": [],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "team_staff_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "StaffMember record IDs in this user's team (DSPs assigned to clients in their caseload). Maintained by syncStaffAssignments function.",
      "default": [],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": []
}