{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string",
      "description": "Email of the person who performed the action"
    },
    "actor_role": {
      "type": "string",
      "description": "App role of the actor at the time of the action"
    },
    "action": {
      "type": "string",
      "description": "e.g. User invited, set_access, deactivate, permission_matrix_change, sensitive_field_view, session_note_approved, impersonate_session_start"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session_start",
        "page_view",
        "session_end",
        "generic"
      ],
      "default": "generic",
      "enumColors": [
        "green",
        "blue",
        "orange",
        "gray"
      ]
    },
    "field": {
      "type": "string",
      "description": "The sensitive field that was revealed or changed"
    },
    "old_value": {
      "type": "string",
      "description": "Value before the change (access level, bundle, permission level, record status)"
    },
    "new_value": {
      "type": "string",
      "description": "Value after the change"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Groups all events in one Login As session"
    },
    "reason": {
      "type": "string",
      "description": "Stated reason for the Login As session"
    },
    "session_start": {
      "type": "string",
      "format": "date-time"
    },
    "session_end": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_path": {
      "type": "string",
      "description": "Route path viewed during Login As"
    },
    "viewed_record_id": {
      "type": "string"
    },
    "viewed_record_type": {
      "type": "string"
    },
    "viewed_record_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "actor_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "audit_immutable"
      }
    },
    "delete": false
  }
}