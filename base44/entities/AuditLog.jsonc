{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "e.g. impersonate_agency, suspend_agency, api_call"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "actor_name"
  ]
}