{
  "name": "House",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "House or program name"
    },
    "address": {
      "type": "string",
      "description": "Street address line"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string",
      "default": "UT"
    },
    "address_zip": {
      "type": "string"
    },
    "geofence_radius": {
      "type": "number",
      "description": "Geofence radius in meters for EVV verification",
      "default": 100
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude for geofence checks"
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude for geofence checks"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "Residential",
        "Day Program",
        "Community Living",
        "Supported Living",
        "Other"
      ],
      "default": "Residential"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string"
    },
    "custom_fields": {
      "type": "object",
      "description": "Answers to admin-defined custom fields, keyed by FormFieldDefinition id. Each value holds the answer plus the field label at the time it was entered. Admin-only answers are stored in RestrictedFieldValue instead."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": {
            "$in": "{{user.data.assigned_house_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "id": {
            "$in": "{{user.data.assigned_house_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}