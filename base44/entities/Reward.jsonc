{
  "name": "Reward",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "e.g. $25 Gift Card, 4 PTO Hours"
    },
    "description": {
      "type": "string"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "Gift Card",
        "PTO Hours",
        "Merchandise",
        "Other"
      ]
    },
    "point_cost": {
      "type": "number",
      "description": "Points required to redeem"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "point_cost"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "dsp"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}