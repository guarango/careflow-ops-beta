{
  "name": "GoalComment",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_type": {
      "type": "string",
      "enum": [
        "Guardian",
        "Case Manager",
        "Staff"
      ]
    },
    "comment": {
      "type": "string"
    },
    "posted_at": {
      "type": "string"
    },
    "visible_to_staff": {
      "type": "boolean",
      "default": true
    },
    "visible_to_portal": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "goal_id",
    "client_id",
    "author_name",
    "comment",
    "author_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}