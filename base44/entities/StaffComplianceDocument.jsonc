{
  "name": "StaffComplianceDocument",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Expired",
        "Pending"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "staff_id",
    "document_type"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "data.staff_id": {
                "$in": "{{user.data.team_staff_ids}}"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    }
  }
}