{
  "name": "AgencyFileItem",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Checklist item name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Certification",
        "Committee",
        "Plan",
        "Process",
        "Insurance",
        "Disclosure"
      ],
      "default": "Process"
    },
    "document_url": {
      "type": "string",
      "description": "Uploaded document file URI (stored privately)"
    },
    "document_name": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Current",
        "Expiring Soon",
        "Expired",
        "N/A"
      ],
      "default": "N/A"
    },
    "last_reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "reviewed_by": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_name",
    "category"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    }
  }
}