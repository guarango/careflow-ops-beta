{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_by_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Behavioral",
        "Medical",
        "Fall",
        "Elopement",
        "Property Damage",
        "Medication Error",
        "Injury",
        "Other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "description": {
      "type": "string"
    },
    "actions_taken": {
      "type": "string"
    },
    "witnesses": {
      "type": "string"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    },
    "follow_up_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Under Review",
        "Resolved",
        "Closed"
      ],
      "default": "Open"
    }
  },
  "required": [
    "client_id",
    "date",
    "type",
    "severity",
    "description"
  ]
}