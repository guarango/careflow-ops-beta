{
  "name": "SessionNote",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string",
      "description": "Linked ShiftSchedule record"
    },
    "service_code_id": {
      "type": "string",
      "description": "Service code for this session"
    },
    "service_code": {
      "type": "string",
      "description": "Denormalized service code for display"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "enum": [
        "Day Program",
        "Community Outing",
        "Residence",
        "Vocational Site",
        "Telehealth",
        "Other"
      ]
    },
    "location_other": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Written summary of what was done during the session"
    },
    "original_summary": {
      "type": "string",
      "description": "DSP's original text before AI cleanup"
    },
    "ai_cleaned_summary": {
      "type": "string",
      "description": "AI-cleaned version of the summary"
    },
    "ai_cleaned_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Approved",
        "Returned",
        "Flagged for Review"
      ],
      "default": "Draft"
    },
    "submitted_at": {
      "type": "string"
    },
    "returned_comment": {
      "type": "string",
      "description": "Comment left by manager when returning a note"
    },
    "returned_by": {
      "type": "string"
    },
    "returned_at": {
      "type": "string"
    },
    "is_late": {
      "type": "boolean",
      "default": false,
      "description": "True if not submitted by the agency deadline"
    },
    "goal_data": {
      "type": "array",
      "description": "Per-goal data entries for this session",
      "items": {
        "type": "object",
        "properties": {
          "goal_id": {
            "type": "string"
          },
          "goal_title": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean",
            "default": false
          },
          "skip_reason": {
            "type": "string"
          },
          "trials_total": {
            "type": "number"
          },
          "trials_correct": {
            "type": "number"
          },
          "percentage": {
            "type": "number"
          },
          "prompt_level": {
            "type": "string"
          },
          "mastery_met": {
            "type": "string",
            "enum": [
              "Yes",
              "No",
              "Partial",
              "Not Enough Trials"
            ]
          },
          "narrative": {
            "type": "string"
          },
          "person_expressed_preference": {
            "type": "boolean"
          },
          "preference_detail": {
            "type": "string"
          },
          "person_communication": {
            "type": "string"
          },
          "session_highlight": {
            "type": "string"
          },
          "engagement": {
            "type": "string",
            "enum": [
              "Motivated",
              "Neutral",
              "Resistant",
              "Distressed",
              "Variable"
            ]
          }
        }
      }
    },
    "health_safety_flags": {
      "type": "object",
      "properties": {
        "fall_or_injury": {
          "type": "boolean",
          "default": false
        },
        "fall_detail": {
          "type": "string"
        },
        "medication_refusal": {
          "type": "boolean",
          "default": false
        },
        "medication_refusal_detail": {
          "type": "string"
        },
        "behavioral_escalation": {
          "type": "boolean",
          "default": false
        },
        "behavioral_detail": {
          "type": "string"
        },
        "health_concern": {
          "type": "boolean",
          "default": false
        },
        "health_detail": {
          "type": "string"
        },
        "restrictive_procedure": {
          "type": "boolean",
          "default": false
        },
        "restrictive_detail": {
          "type": "string"
        }
      }
    },
    "session_overall_notes": {
      "type": "string"
    },
    "supervisor_note": {
      "type": "string"
    },
    "supervisor_reviewed_by": {
      "type": "string"
    },
    "supervisor_reviewed_at": {
      "type": "string"
    },
    "supervisor_action": {
      "type": "string",
      "enum": [
        "Approved",
        "Coaching Note Added",
        "Flagged for Clinical Review"
      ]
    },
    "addenda": {
      "type": "array",
      "description": "Admin addenda \u2014 never overwrite the original note",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "added_by": {
            "type": "string"
          },
          "added_at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "version_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "saved_at": {
            "type": "string"
          },
          "saved_by": {
            "type": "string"
          },
          "summary_of_changes": {
            "type": "string"
          }
        }
      }
    },
    "offline_created": {
      "type": "boolean",
      "default": false
    },
    "synced_at": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}