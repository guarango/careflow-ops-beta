{
  "name": "EVVLog",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string",
      "description": "Linked ShiftSchedule record"
    },
    "timecard_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "member_id": {
      "type": "string",
      "description": "Recipient Medicaid member ID captured at submission time (Utah Member ID)"
    },
    "house_id": {
      "type": "string"
    },
    "house_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "service_code": {
      "type": "string"
    },
    "service_description": {
      "type": "string"
    },
    "is_evv_required": {
      "type": "boolean",
      "default": false
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "units": {
      "type": "number",
      "description": "Billable units for the visit (15-minute units)"
    },
    "location_in_lat": {
      "type": "number"
    },
    "location_in_lng": {
      "type": "number"
    },
    "location_in_address": {
      "type": "string"
    },
    "location_in_city": {
      "type": "string"
    },
    "location_in_state": {
      "type": "string"
    },
    "location_in_zip": {
      "type": "string"
    },
    "location_out_lat": {
      "type": "number"
    },
    "location_out_lng": {
      "type": "number"
    },
    "location_out_address": {
      "type": "string"
    },
    "location_out_city": {
      "type": "string"
    },
    "location_out_state": {
      "type": "string"
    },
    "location_out_zip": {
      "type": "string"
    },
    "geofence_distance_in": {
      "type": "number",
      "description": "Distance from house geofence at clock-in (meters)"
    },
    "geofence_distance_out": {
      "type": "number",
      "description": "Distance from house geofence at clock-out (meters)"
    },
    "exception_type": {
      "type": "string",
      "enum": [
        "none",
        "missed_punch",
        "geofence_violation",
        "manual_entry"
      ],
      "default": "none"
    },
    "reason_code": {
      "type": "string",
      "description": "DSP-provided reason for exception"
    },
    "exception_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "is_manual_entry": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Submitted",
        "Accepted",
        "Rejected",
        "Corrected"
      ],
      "default": "Pending"
    },
    "provider_npi": {
      "type": "string",
      "description": "Provider NPI used for the submission"
    },
    "provider_prism_id": {
      "type": "string",
      "description": "Provider PRISM / Medicaid provider ID used for the submission"
    },
    "vendor_name": {
      "type": "string",
      "description": "EVV solution vendor name (Utah required field)"
    },
    "export_batch_id": {
      "type": "string",
      "description": "Provider-assigned Batch ID of the export this record was included in (numeric)"
    },
    "record_id": {
      "type": "string",
      "description": "Provider-assigned Record ID within the batch (numeric)"
    },
    "exported_at": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string",
      "description": "State-issued receipt ID from the Utah EVV acknowledgement"
    },
    "orig_receipt_id": {
      "type": "string",
      "description": "Original receipt ID when submitting a correction"
    },
    "is_correction": {
      "type": "boolean",
      "default": false
    },
    "correction_reason": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason returned by Utah EVV when a record is rejected"
    },
    "aggregator_response": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "staff_id",
    "date",
    "service_type"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "data.staff_id": {
                "$in": "{{user.data.team_staff_ids}}"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.staff_id": "{{user.data.staff_member_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    }
  }
}