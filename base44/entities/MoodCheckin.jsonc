{
  "name": "MoodCheckin",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "portal_user_id": {
      "type": "string"
    },
    "mood_score": {
      "type": "number",
      "description": "1-5 scale: 1=very sad, 5=very happy"
    },
    "mood_label": {
      "type": "string",
      "enum": [
        "Very Sad",
        "Sad",
        "Okay",
        "Happy",
        "Very Happy"
      ]
    },
    "note": {
      "type": "string",
      "description": "Optional note from client"
    },
    "checked_in_at": {
      "type": "string"
    },
    "viewed_by_staff": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "client_name",
    "mood_score",
    "mood_label"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.portal_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.portal_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.portal_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.portal_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}