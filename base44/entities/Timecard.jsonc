{
  "name": "Timecard",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "total_hours": {
      "type": "number"
    },
    "break_minutes": {
      "type": "number",
      "default": 0
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "locked_by": {
      "type": "string"
    },
    "locked_at": {
      "type": "string"
    },
    "pay_period_label": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "service_code_id": {
      "type": "string"
    },
    "service_code": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "approval_timestamp": {
      "type": "string",
      "description": "Signature timestamp recorded at approval"
    },
    "evv_location_in": {
      "type": "object",
      "description": "GPS location data captured at clock-in"
    },
    "evv_location_out": {
      "type": "object",
      "description": "GPS location data captured at clock-out"
    },
    "correction_requested": {
      "type": "boolean",
      "default": false
    },
    "correction_reason": {
      "type": "string",
      "description": "Reason submitted by DSP for requesting a correction"
    },
    "correction_requested_at": {
      "type": "string"
    },
    "correction_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "returned"
      ],
      "default": "none"
    },
    "corrected_clock_in": {
      "type": "string",
      "description": "Corrected clock-in time proposed by DSP"
    },
    "corrected_clock_out": {
      "type": "string",
      "description": "Corrected clock-out time proposed by DSP"
    },
    "correction_reviewed_by": {
      "type": "string"
    },
    "correction_reviewed_at": {
      "type": "string"
    },
    "correction_manager_note": {
      "type": "string",
      "description": "Manager note when returning a correction"
    }
  },
  "required": [
    "staff_id",
    "date",
    "clock_in"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.staff_id": "{{user.data.staff_member_id}}"
        },
        {
          "data.staff_id": {
            "$in": "{{user.data.team_staff_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}