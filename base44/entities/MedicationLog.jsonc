{
  "name": "MedicationLog",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "administered_by": {
      "type": "string"
    },
    "administered_by_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Administered",
        "Refused",
        "Held",
        "Not Available",
        "Missed"
      ],
      "default": "Administered"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_id",
    "client_id",
    "date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": {
            "$in": "{{user.data.assigned_client_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}