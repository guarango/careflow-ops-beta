{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "PTO",
        "Sick Leave",
        "FMLA",
        "Leave of Absence",
        "Holiday",
        "Bereavement",
        "Other"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "total_days": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Denied",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "manager_notes": {
      "type": "string"
    }
  },
  "required": [
    "staff_id",
    "leave_type",
    "start_date",
    "end_date"
  ]
}