{
  "name": "MonthlySummary",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "month_year": {
      "type": "string",
      "description": "e.g. 'October 2026'"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "deliverable": {
      "type": "boolean",
      "default": true,
      "description": "True when this summary is due to the support coordinator; false for the internal monthly progress note that feeds the quarterly (SOW 1.25)"
    },
    "service_code_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service codes this summary covers"
    },
    "service_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Codes for display"
    },
    "summary_cadence": {
      "type": "string",
      "enum": [
        "Monthly",
        "Quarterly",
        "Monthly Financial Statement"
      ],
      "description": "Cadence that produced this record"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Period end + the agency's due days (default 15) \u2014 state rule not yet confirmed"
    },
    "is_placeholder": {
      "type": "boolean",
      "default": false,
      "description": "True for a monthly financial statement task \u2014 the template is not built yet"
    },
    "writer_name": {
      "type": "string",
      "description": "Manager who wrote or is assigned to write it"
    },
    "writer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending Review",
        "Signed",
        "Returned"
      ],
      "default": "Draft"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "ai_generated_at": {
      "type": "string"
    },
    "how_month_went": {
      "type": "string",
      "description": "Narrative summary of the month"
    },
    "citations": {
      "type": "array",
      "description": "Each narrative sentence with the approved session notes behind it \u2014 drives the hover source panel",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "month",
              "goal",
              "events"
            ],
            "default": "month"
          },
          "source_note_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_note_dates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "goals_summary": {
      "type": "array",
      "description": "Per-goal progress with code-computed numbers and source note references",
      "items": {
        "type": "object",
        "properties": {
          "goal_id": {
            "type": "string"
          },
          "goal_title": {
            "type": "string"
          },
          "sessions_charted": {
            "type": "number"
          },
          "data_points": {
            "type": "number",
            "description": "Valid, cited data points this period"
          },
          "average_score": {
            "type": "number"
          },
          "first_score": {
            "type": "number"
          },
          "last_score": {
            "type": "number"
          },
          "prompt_trend": {
            "type": "string"
          },
          "minutes": {
            "type": "number",
            "description": "Service minutes from the cited approved notes"
          },
          "progress_summary": {
            "type": "string"
          },
          "source_note_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_note_dates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "data_needing_review": {
      "type": "array",
      "description": "Flagged or excluded goal entries \u2014 never reported as progress",
      "items": {
        "type": "object",
        "properties": {
          "goal_title": {
            "type": "string"
          },
          "goal_id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "recorded": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "staff_name": {
            "type": "string"
          }
        }
      }
    },
    "notable_events": {
      "type": "string",
      "description": "Incidents, behavioral events, health changes"
    },
    "source_note_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All approved session notes referenced"
    },
    "source_data": {
      "type": "object",
      "properties": {
        "note_count": {
          "type": "number"
        },
        "incident_count": {
          "type": "number"
        },
        "med_pass_count": {
          "type": "number"
        },
        "goals_charted_count": {
          "type": "number"
        },
        "goal_entries_flagged": {
          "type": "number"
        }
      }
    },
    "generation": {
      "type": "object",
      "description": "Provenance of the AI draft \u2014 model, every input record ID, and the output hash",
      "properties": {
        "model": {
          "type": "string"
        },
        "input_note_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_goal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_incident_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_med_log_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_hash": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        }
      }
    },
    "sign_blocked_reason": {
      "type": "string",
      "description": "Set when the draft cannot be signed, e.g. goal data with no approved session notes"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "version_history": {
      "type": "array",
      "description": "Prior drafts and manual edits, newest first \u2014 regeneration never discards them",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "saved_at": {
            "type": "string"
          },
          "saved_by": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai_draft",
              "manual_edit",
              "prior_draft"
            ]
          },
          "how_month_went": {
            "type": "string"
          },
          "goals_summary": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "notable_events": {
            "type": "string"
          },
          "data_needing_review": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "signed_by": {
      "type": "string",
      "description": "StaffMember ID of signer"
    },
    "signed_by_name": {
      "type": "string"
    },
    "signed_by_role": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "signature_timestamp": {
      "type": "string"
    },
    "returned_note": {
      "type": "string"
    },
    "returned_by": {
      "type": "string"
    },
    "returned_at": {
      "type": "string"
    },
    "quarterly_summary_id": {
      "type": "string",
      "description": "Linked quarterly summary once assembled"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "month_year",
    "period_start",
    "period_end",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}