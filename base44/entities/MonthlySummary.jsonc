{
  "name": "MonthlySummary",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "month_year": {
      "type": "string",
      "description": "e.g. 'October 2026'"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "deliverable": {
      "type": "boolean",
      "default": true,
      "description": "True when this summary is due to the support coordinator; false for the internal monthly progress note that feeds the quarterly (SOW 1.25)"
    },
    "service_code_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service codes this summary covers"
    },
    "service_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Codes for display"
    },
    "summary_cadence": {
      "type": "string",
      "enum": [
        "Monthly",
        "Quarterly",
        "Monthly Financial Statement"
      ],
      "description": "Cadence that produced this record"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Period end + the agency's due days (default 15) \u2014 state rule not yet confirmed"
    },
    "is_placeholder": {
      "type": "boolean",
      "default": false,
      "description": "True for a monthly financial statement task \u2014 the template is not built yet"
    },
    "writer_name": {
      "type": "string",
      "description": "Manager who wrote or is assigned to write it"
    },
    "writer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Pending Review",
        "Signed",
        "Returned"
      ],
      "default": "Draft"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "ai_generated_at": {
      "type": "string"
    },
    "how_month_went": {
      "type": "string",
      "description": "Narrative summary of the month"
    },
    "goals_summary": {
      "type": "array",
      "description": "Per-goal progress with numbers and source note references",
      "items": {
        "type": "object",
        "properties": {
          "goal_title": {
            "type": "string"
          },
          "sessions_charted": {
            "type": "number"
          },
          "progress_summary": {
            "type": "string"
          },
          "source_note_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notable_events": {
      "type": "string",
      "description": "Incidents, behavioral events, health changes"
    },
    "source_note_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All session notes referenced"
    },
    "source_data": {
      "type": "object",
      "properties": {
        "note_count": {
          "type": "number"
        },
        "incident_count": {
          "type": "number"
        },
        "med_pass_count": {
          "type": "number"
        },
        "goals_charted_count": {
          "type": "number"
        },
        "goal_entries_flagged": {
          "type": "number"
        }
      }
    },
    "signed_by": {
      "type": "string",
      "description": "StaffMember ID of signer"
    },
    "signed_by_name": {
      "type": "string"
    },
    "signed_by_role": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "signature_timestamp": {
      "type": "string"
    },
    "returned_note": {
      "type": "string"
    },
    "returned_by": {
      "type": "string"
    },
    "returned_at": {
      "type": "string"
    },
    "quarterly_summary_id": {
      "type": "string",
      "description": "Linked quarterly summary once assembled"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "month_year",
    "period_start",
    "period_end",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}