{
  "name": "ReleaseNote",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "improvement",
        "bugfix",
        "maintenance"
      ],
      "default": "feature"
    },
    "target_agencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Empty = all agencies"
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "version",
    "title",
    "content",
    "release_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "is_deactivated": false
      }
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_deactivated": false
          }
        }
      ]
    }
  }
}