{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Agency this rule belongs to"
    },
    "event_key": {
      "type": "string",
      "description": "Stable slug (e.g. med_pass_not_documented, critical_incident)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "client_safety",
        "medication",
        "charting",
        "shifts_evv",
        "staff_compliance",
        "hr_team"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "action",
        "fyi"
      ]
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Locked rules cannot be disabled; Push/SMS/Email cannot all be turned off on Critical rules"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "channels": {
      "type": "object",
      "description": "Channel toggles (in-app is always on)",
      "properties": {
        "push": {
          "type": "boolean",
          "default": false
        },
        "email": {
          "type": "boolean",
          "default": false
        },
        "sms": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dsp_on_shift",
          "assigned_dsps",
          "client_manager",
          "house_manager",
          "admin",
          "hr_bundle",
          "billing_bundle",
          "self"
        ]
      },
      "description": "Recipient roles for this rule"
    },
    "timing": {
      "type": "object",
      "description": "Editable timing thresholds (e.g. after_minutes, days_before, count, days)"
    },
    "escalation": {
      "type": "object",
      "description": "Escalation config if not resolved, or null",
      "properties": {
        "after_minutes": {
          "type": "number"
        },
        "to_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channels": {
          "type": "object",
          "properties": {
            "push": {
              "type": "boolean"
            },
            "email": {
              "type": "boolean"
            },
            "sms": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "digest_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the daily 7AM digest email to Managers and Admins"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "event_key",
    "label",
    "category",
    "severity",
    "enabled"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}