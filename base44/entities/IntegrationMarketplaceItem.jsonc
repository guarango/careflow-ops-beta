{
  "name": "IntegrationMarketplaceItem",
  "type": "object",
  "properties": {
    "integration_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "mmis",
        "ehr",
        "payroll",
        "accounting",
        "background_check",
        "lms",
        "communication",
        "document",
        "fax",
        "other"
      ]
    },
    "vendor": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "tier_access": {
      "type": "string",
      "enum": [
        "all",
        "professional_enterprise",
        "enterprise_only"
      ],
      "default": "all"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "is_beta": {
      "type": "boolean",
      "default": false
    },
    "requires_baa": {
      "type": "boolean",
      "default": false
    },
    "supported_directions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adoption_count": {
      "type": "number",
      "default": 0
    },
    "docs_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "integration_key",
    "name",
    "category"
  ]
}